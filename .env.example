# Everything is optional. Without DATABASE_URL the site still builds and runs;
# the contact form then offers email instead and the visit counter is hidden.

# Public address of the site (used for canonical links, the sitemap and share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string (contact messages and the visit counter)
DATABASE_URL=

# Salt for hashing visitor IPs before they are stored (rate limiting only)
IP_HASH_SALT=

# Optional: email a copy of each contact message through Resend
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
